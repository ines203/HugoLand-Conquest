<Window x:Class="HugoLandWpf.CreatePlayersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Players" Height="340" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#111520">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Start!" Width="90" Margin="0,0,10,0"
                    Background="#059669" Foreground="White"
                    BorderThickness="0" Padding="0,10"
                    FontSize="12" FontFamily="Consolas" Cursor="Hand"
                    Click="BtnDemarrer_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancel" Width="80"
                    Background="#1A0A0A" Foreground="#EF4444"
                    BorderBrush="#3F1515" BorderThickness="1"
                    Padding="0,10" FontSize="12" FontFamily="Consolas"
                    Cursor="Hand" Click="BtnAnnuler_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3F1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Player Setup"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       FontFamily="Segoe UI" Margin="0,0,0,20"/>

            <TextBlock Text="Player 1 name:"
                       Foreground="#93C5FD" FontSize="12" FontFamily="Consolas"/>
            <TextBox x:Name="TxtJoueur1" Background="#1A2035" Foreground="White"
                     BorderBrush="#3B82F6" BorderThickness="1"
                     Margin="0,6,0,16" Padding="8,7"
                     FontSize="13" CaretBrush="White"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Player 2 name:"
                           Foreground="#FCA5A5" FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkIA" Content="  AI opponent"
                          Foreground="#F59E0B" FontSize="11" FontFamily="Consolas"
                          Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="ChkIA_Checked" Unchecked="ChkIA_Unchecked"/>
            </StackPanel>
            <TextBox x:Name="TxtJoueur2" Background="#1A2035" Foreground="White"
                     BorderBrush="#EF4444" BorderThickness="1"
                     Margin="0,2,0,0" Padding="8,7"
                     FontSize="13" CaretBrush="White"/>
        </StackPanel>
    </DockPanel>
</Window>
