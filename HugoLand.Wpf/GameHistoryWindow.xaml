<Window x:Class="HugoLandWpf.GameHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game History" Height="620" Width="780"
        Background="#0D1018"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="📜  GAME HISTORY" Foreground="#F59E0B"
                   FontSize="16" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,16"/>

        <!-- Statistiques globales -->
        <Border Grid.Row="1" Background="#111520" BorderBrush="#1E293B"
                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="GLOBAL PERFORMANCE" Foreground="#64748B"
                           FontSize="9" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTotalGames" Text="0"
                                   Foreground="#E2E8F0" FontSize="22" FontWeight="Bold"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="GAMES" Foreground="#64748B" FontSize="9"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtWinRate" Text="0%"
                                   Foreground="#34D399" FontSize="22" FontWeight="Bold"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="WIN RATE" Foreground="#64748B" FontSize="9"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtAvgTurns" Text="0"
                                   Foreground="#60A5FA" FontSize="22" FontWeight="Bold"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="AVG TURNS" Foreground="#64748B" FontSize="9"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtAvgGold" Text="0"
                                   Foreground="#F59E0B" FontSize="22" FontWeight="Bold"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="AVG GOLD" Foreground="#64748B" FontSize="9"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Filtres et tri -->
        <Border Grid.Row="2" Background="#111520" BorderBrush="#1E293B"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter: " Foreground="#64748B" FontSize="11"
                           FontFamily="Consolas" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbFilter" Width="130" Margin="4,0,16,0"
                          Background="#1E293B" Foreground="#E2E8F0"
                          FontFamily="Consolas" FontSize="11"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All games" IsSelected="True"/>
                    <ComboBoxItem Content="Wins only"/>
                    <ComboBoxItem Content="Finished"/>
                </ComboBox>

                <TextBlock Text="Sort by: " Foreground="#64748B" FontSize="11"
                           FontFamily="Consolas" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbSort" Width="100" Margin="4,0,0,0"
                          Background="#1E293B" Foreground="#E2E8F0"
                          FontFamily="Consolas" FontSize="11"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Newest" IsSelected="True"/>
                    <ComboBoxItem Content="Oldest"/>
                    <ComboBoxItem Content="Most turns"/>
                    <ComboBoxItem Content="Fewest turns"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Liste des parties -->
        <Border Grid.Row="3" Background="#111520" BorderBrush="#1E293B"
                BorderThickness="1" CornerRadius="6" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="GameListPanel" Margin="0"/>
            </StackPanel>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Background="#1E3A5F" BorderBrush="#3B82F6"
                    Foreground="#93C5FD" FontFamily="Consolas" Padding="16,6"
                    Margin="0,0,8,0" Click="BtnRefresh_Click"/>
            <Button Content="Close" Background="#1E293B" BorderBrush="#334155"
                    Foreground="#94A3B8" FontFamily="Consolas" Padding="16,6"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
