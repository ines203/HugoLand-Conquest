<Window x:Class="HugoLandWpf.GameReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Report" Height="700" Width="800"
        Background="#0D1018"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- En-tête -->
            <Border Background="#111520" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="6" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🏆  POST-GAME REPORT" Foreground="#F59E0B"
                               FontSize="18" FontWeight="Bold" FontFamily="Consolas"/>
                    <TextBlock x:Name="TxtGameName" Foreground="#94A3B8"
                               FontSize="12" FontFamily="Consolas" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="WINNER : " Foreground="#64748B" FontSize="13" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtWinner" Foreground="#34D399"
                                   FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Duration : " Foreground="#64748B" FontSize="11" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtTurns" Foreground="#94A3B8"
                                   FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Statistiques finales -->
            <Border Background="#111520" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="FINAL STATISTICS" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtWinnerName2" Foreground="#60A5FA"
                                       FontSize="12" FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtWinnerStats" Foreground="#94A3B8"
                                       FontSize="11" FontFamily="Consolas" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="VS" Foreground="#475569"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Consolas"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="TxtLoserName" Foreground="#F87171"
                                       FontSize="12" FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtLoserStats" Foreground="#94A3B8"
                                       FontSize="11" FontFamily="Consolas" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Top 5 actions -->
            <Border Background="#111520" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="TOP 5 ACTIONS" Style="{StaticResource SectionTitle}"/>
                    <StackPanel x:Name="TopActionsPanel"/>
                </StackPanel>
            </Border>

            <!-- Carte des combats -->
            <Border Background="#111520" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="COMBAT HEATMAP  (territory intensity)" Style="{StaticResource SectionTitle}"/>
                    <Canvas x:Name="HeatmapCanvas" Height="200" Background="#0D1018" ClipToBounds="True"/>
                </StackPanel>
            </Border>

            <!-- Graphique force -->
            <Border Background="#111520" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="FORCE EVOLUTION" Style="{StaticResource SectionTitle}"/>
                    <StackPanel x:Name="ChartLegend" Orientation="Horizontal" Margin="0,0,0,8"/>
                    <Canvas x:Name="ForceChartCanvas" Height="140" Background="#0D1018" ClipToBounds="True"/>
                </StackPanel>
            </Border>

            <!-- Bouton fermer -->
            <Button Content="Close" Background="#1E293B" BorderBrush="#334155"
                    Foreground="#94A3B8" FontFamily="Consolas" Padding="24,8"
                    HorizontalAlignment="Right" Margin="0,4,0,0"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
