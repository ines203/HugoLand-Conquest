<Window x:Class="HugoLandWpf.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HugoLand: Conquest" Height="820" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        Closing="Window_Closing"
        Icon="Assets/HugoLand_Conquest_Logo.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ PANNEAU GAUCHE ══ -->
        <Border Grid.Column="0" Background="#0D1018"
                BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Bandeau joueur — data-binding -->
                <Border x:Name="BrdJoueur" DockPanel.Dock="Top" Padding="14,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="GradStop1" Color="#1D4ED8" Offset="0"/>
                            <GradientStop x:Name="GradStop2" Color="#0D2A70" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{Binding TurnHeader}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="⬡ " Foreground="#F59E0B" FontSize="15"/>
                            <TextBlock Text="{Binding GoldText}"
                                       Foreground="#FCD34D" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DebtText}"
                                   Foreground="#FCA5A5" FontSize="11" Margin="0,3,0,0"
                                   Visibility="{Binding HasDebt, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Stats — data-binding -->
                <Border DockPanel.Dock="Top" Padding="14,8"
                        Background="#111520" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ARMIES"    Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="FORCE"     Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ArmyCount}"
                                   FontSize="20" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalForce}"
                                   FontSize="20" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="FORTRESSES" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="ECONOMY"   Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding FortressCount}"
                                   FontSize="16" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Consolas"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding EarningsText}"    FontSize="12" Foreground="#10B981" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding MaintenanceText}" FontSize="12" Foreground="#EF4444" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Armée sélectionnée + actions -->
                <Border DockPanel.Dock="Top" Padding="14,10"
                        Background="#0D1018" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="SELECTED ARMY" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding SelectedArmyInfo}"
                                   Foreground="#64748B" FontSize="11"
                                   FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Button x:Name="BtnDeplacer"  Content="[ 1 ]  Move"
                                Style="{StaticResource ActionBtn}"
                                Background="#1E3A5F" BorderBrush="#3B82F6" Foreground="#93C5FD"
                                IsEnabled="{Binding CanMove}"
                                Click="BtnDeplacer_Click"/>
                        <Button x:Name="BtnCamp"      Content="[ 2 ]  Build Camp  (20g)"
                                Style="{StaticResource ActionBtn}"
                                Background="#2E1B4E" BorderBrush="#7C3AED" Foreground="#C4B5FD"
                                IsEnabled="{Binding CanBuildCamp}"
                                Click="BtnCamp_Click"/>
                        <Button x:Name="BtnFort"      Content="[ 3 ]  Fortify  (50g)"
                                Style="{StaticResource ActionBtn}"
                                Background="#3B2A00" BorderBrush="#F59E0B" Foreground="#FCD34D"
                                IsEnabled="{Binding CanFortify}"
                                Click="BtnFort_Click"/>
                        <Button x:Name="BtnRenforcer" Content="[ 4 ]  Reinforce  (2g/troop)"
                                Style="{StaticResource ActionBtn}"
                                Background="#0D2E1E" BorderBrush="#10B981" Foreground="#6EE7B7"
                                IsEnabled="{Binding CanReinforce}"
                                Click="BtnRenforcer_Click"/>
                        <Button x:Name="BtnScinder"   Content="[ 5 ]  Split Army"
                                Style="{StaticResource ActionBtn}"
                                Background="#3B1A00" BorderBrush="#F97316" Foreground="#FDBA74"
                                IsEnabled="{Binding CanSplit}"
                                Click="BtnScinder_Click"/>
                        <Button x:Name="BtnPasser"    Content="[ 6 ]  Pass"
                                Style="{StaticResource ActionBtn}"
                                Background="#1A1A2A" BorderBrush="#334155" Foreground="#64748B"
                                IsEnabled="{Binding CanPass}"
                                Click="BtnPasser_Click"/>
                    </StackPanel>
                </Border>

                <!-- Journal -->
                <Border DockPanel.Dock="Top" Padding="14,8" Background="#0A0C10">
                    <StackPanel>
                        <TextBlock Text="COMBAT LOG" Style="{StaticResource SectionLabel}"/>
                        <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding CombatLog}"
                                       Foreground="#475569" FontSize="10"
                                       FontFamily="Consolas" TextWrapping="Wrap" LineHeight="16"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Boutons bas -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,6">
                    <Button Content="📊  DASHBOARD"
                            Background="#1E293B" Foreground="#F59E0B"
                            BorderBrush="#78350F" BorderThickness="1"
                            FontSize="10" FontFamily="Consolas"
                            Padding="0,7" Cursor="Hand"
                            Click="BtnDashboard_Click" Margin="0,0,0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#292524"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="QUIT GAME"
                            Background="#1A0A0A" Foreground="#EF4444"
                            BorderBrush="#3F1515" BorderThickness="1"
                            FontSize="11" FontFamily="Consolas"
                            Padding="0,8" Cursor="Hand"
                            Click="BtnQuit_Click" Margin="0,0,0,6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3F1515"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="END TURN  →"
                            Background="#059669" Foreground="White"
                            BorderThickness="0" FontSize="13" FontWeight="Bold"
                            FontFamily="Segoe UI" Padding="0,13"
                            Cursor="Hand" Click="BtnFinTour_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#10B981"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══ ZONE DE JEU ══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0D1018"
                    BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,0">
                <DockPanel>
                    <TextBlock Text="{Binding MapTitle}"
                               Foreground="#94A3B8" FontSize="12"
                               FontFamily="Consolas" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Width="12" Height="12" Background="#4A7C59" CornerRadius="2" Margin="4,0,2,0"/>
                        <TextBlock Text="Plain"    Foreground="#64748B" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="12" Height="12" Background="#2D5016" CornerRadius="2" Margin="4,0,2,0"/>
                        <TextBlock Text="Forest"   Foreground="#64748B" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="12" Height="12" Background="#8B7355" CornerRadius="2" Margin="4,0,2,0"/>
                        <TextBlock Text="Mountain" Foreground="#64748B" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="12" Height="12" Background="#1E6091" CornerRadius="2" Margin="4,0,2,0"/>
                        <TextBlock Text="Sea"      Foreground="#64748B" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#080A0F" Padding="6">
                <Canvas x:Name="CanvasJeu"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
