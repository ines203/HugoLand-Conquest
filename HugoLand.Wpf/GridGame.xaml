<Window x:Class="HugoLand.Wpf.GridGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.Wpf"
        mc:Ignorable="d"
        Title="GridGame" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="22*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="p1Name" HorizontalAlignment="Center" Height="53" Margin="0,10,0,0" VerticalAlignment="Top">
            <Label Content="Player 1" HorizontalAlignment="Center" VerticalAlignment="Top" Width="154" Height="26"/>
            <Label Content="*Name*" HorizontalAlignment="Center" Margin="0,26,0,0" VerticalAlignment="Top" Height="27" Width="154"/>
        </Grid>
        <Grid x:Name="p2Name" Grid.Column="2" HorizontalAlignment="Left" Height="53" VerticalAlignment="Top">
            <Label Content="Player 2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="154" Height="26"/>
            <Label Content="*Name*" HorizontalAlignment="Left" Margin="0,26,0,0" VerticalAlignment="Top" Height="27" Width="154"/>
        </Grid>
        <Grid x:Name="p1Armies" HorizontalAlignment="Center" Margin="0,73,0,0" VerticalAlignment="Top">
            <Label Content="Armies" Width="160"/>
            <ListView d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="ListView_SelectionChanged" Height="160" Width="160">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header ="Id" Width="20"/>
                        <GridViewColumn Header ="Coords" Width="45"/>
                        <GridViewColumn Header ="Force" Width="40"/>
                        <GridViewColumn Header ="Energy" Width="50"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        <Grid x:Name="p2Armies" HorizontalAlignment="Center" Margin="0,73,0,0" VerticalAlignment="Top" Grid.Column="2">
            <Label Content="Armies" Width="160"/>
            <ListView d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="ListView_SelectionChanged" Height="160" Width="160">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header ="Id" Width="20"/>
                        <GridViewColumn Header ="Coords" Width="45"/>
                        <GridViewColumn Header ="Force" Width="40"/>
                        <GridViewColumn Header ="Energy" Width="50"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        <Label x:Name="p1Gold" Content="Gold: 0" HorizontalAlignment="Left" Margin="13,273,0,0" VerticalAlignment="Top"/>
        <Label x:Name="p2Gold" Content="Gold: 0" HorizontalAlignment="Left" Margin="10,273,0,0" VerticalAlignment="Top" Grid.Column="2"/>
        <Label x:Name="turnDisplay" Grid.Column="1" Content="Player 1's turn" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="420" HorizontalContentAlignment="Center" FontSize="16"/>
    </Grid>
</Window>
