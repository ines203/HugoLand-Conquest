<Window x:Name="GridGame" x:Class="HugoLand.Wpf.GridGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.Wpf"
        mc:Ignorable="d"
        Title="GridGame" Height="450" Width="800">
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="p1Name" HorizontalAlignment="Left" Height="53" Margin="13,10,0,0" VerticalAlignment="Top" Width="154">
            <Label x:Name="lblPlayerNo" Content="Player 1" HorizontalAlignment="Center" VerticalAlignment="Top" Width="154" Height="26"/>
            <Label x:Name="lblPlayerName" Content="*Name*" HorizontalAlignment="Center" Margin="0,26,0,0" VerticalAlignment="Top" Height="27" Width="154"/>
        </Grid>
        <Grid x:Name="pArmies" HorizontalAlignment="Left" Margin="10,68,0,0" VerticalAlignment="Top" Height="160" Width="176">
            <Label x:Name="lblArmies" Content="Armies" Margin="0,0,0,133"/>
            <ListView x:Name="lstArmies" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="ListView_SelectionChanged" Margin="0,27,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header ="Id" Width="20"/>
                        <GridViewColumn Header ="Coords" Width="45"/>
                        <GridViewColumn Header ="Force" Width="40"/>
                        <GridViewColumn Header ="Energy" Width="50"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        <Label x:Name="lblPGold" Content="Gold: 0" HorizontalAlignment="Left" Margin="227,25,0,0" VerticalAlignment="Top" Height="26" Width="48"/>
        <Label x:Name="turnDisplay" Grid.Column="1" Content="Player 1's turn" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="420" HorizontalContentAlignment="Center" FontSize="16" Height="31"/>
        <Grid x:Name="pInstallations" HorizontalAlignment="Left" Margin="13,234,0,0" VerticalAlignment="Top" Height="160" Width="176">
            <Label x:Name="lblInstallations" Content="Installations" Margin="0,0,0,133"/>
            <ListView x:Name="lstInstallations" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="ListView_SelectionChanged" Margin="0,27,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header ="Id" Width="50"/>
                        <GridViewColumn Header ="Coords" Width="50"/>
                        <GridViewColumn Header ="Type" Width="40"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        <Grid x:Name="_6x6_grid" Grid.Column="1" Margin="65,50,65,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="0" Grid.RowSpan="2" Grid.Row="0" Margin="0,0,0,0"/>
            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="0" Grid.RowSpan="2" Grid.Row="1" Margin="0,0,0,0"/>
            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="0" Grid.RowSpan="2" Grid.Row="2" Margin="0,0,0,0"/>
            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="0" Grid.RowSpan="2" Grid.Row="3" Margin="0,0,0,0"/>
            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="0" Grid.RowSpan="2" Grid.Row="4" Margin="0,0,0,0"/>
            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="0" Grid.RowSpan="2" Grid.Row="5" Margin="0,0,0,0"/>

            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="1" Grid.RowSpan="2" Grid.Row="0" Margin="0,0,0,0"/>
            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="1" Grid.RowSpan="2" Grid.Row="1" Margin="0,0,0,0"/>
            <Image HorizontalAlignment="Left" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="1" Grid.RowSpan="2" Grid.Row="2" Margin="0,0,0,0"/>
