            <Image HorizontalAlignment="Right" Height="56" VerticalAlignment="Top" Width="56" RenderTransformOrigin="0.065,0.032" Grid.ColumnSpan="2" Grid.Column="4" Grid.RowSpan="2" Grid.Row="5" Margin="0,0,0,0"/>
            
