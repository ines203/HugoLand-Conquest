<Window x:Class="HugoLandWpf.LoadGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Game" Height="420" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#111520"
        Icon="Assets/HugoLand_Conquest_Logo.ico">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Load" Width="90" Margin="0,0,10,0"
                    Background="#1D4ED8" Foreground="White"
                    BorderThickness="0" Padding="0,10"
                    FontSize="12" FontFamily="Consolas" Cursor="Hand"
                    Click="BtnCharger_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancel" Width="80"
                    Background="#1A0A0A" Foreground="#EF4444"
                    BorderBrush="#3F1515" BorderThickness="1"
                    Padding="0,10" FontSize="12" FontFamily="Consolas"
                    Cursor="Hand" Click="BtnAnnuler_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3F1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Saved Games"
                       Foreground="White" FontSize="15" FontWeight="Bold"
                       FontFamily="Segoe UI" Margin="0,0,0,14"/>
            <ListBox x:Name="LstParties" Height="260"
                     Background="#1A2035" Foreground="White"
                     BorderBrush="#1E293B" FontSize="12"
                     FontFamily="Consolas" Padding="4"/>
        </StackPanel>
    </DockPanel>
</Window>
