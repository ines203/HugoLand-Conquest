<Window x:Class="HugoLandWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HugoLand: Conquest" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        ResizeMode="CanMinimize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ── Fond décoratif gauche ── -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <!-- Grille décorative simulant une carte -->
            <Canvas x:Name="DecoCanvas" Background="#0A0C10" Opacity="1">
                <!-- Hexagone décoratif flou -->
                <Ellipse Width="500" Height="500" Canvas.Left="-100" Canvas.Top="-50"
                         Fill="#0D1A2A" Opacity="0.6"/>
                <Ellipse Width="300" Height="300" Canvas.Left="100" Canvas.Top="150"
                         Fill="#0E2A1A" Opacity="0.4"/>
                <!-- Titre principal -->
                <StackPanel Canvas.Left="50" Canvas.Top="180" Width="380">
                    <TextBlock Text="HUGOLAND" FontSize="52" FontWeight="Black"
                               FontFamily="Segoe UI Black" Foreground="White"/>
                    <TextBlock Text="CONQUEST" FontSize="52" FontWeight="Black"
                               FontFamily="Segoe UI Black">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#10B981" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <Rectangle Height="3" Width="200" HorizontalAlignment="Left" Margin="0,8,0,20">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Strategic turn-based warfare"
                               FontSize="14" Foreground="#64748B"
                               FontFamily="Segoe UI" FontStyle="Italic"/>
                </StackPanel>

                <!-- Mini carte décorative -->
                <Border Canvas.Left="50" Canvas.Top="380" Width="320" Height="130"
                        Background="#0D1520" CornerRadius="8"
                        BorderBrush="#1E293B" BorderThickness="1">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- Quelques cellules décoratives -->
                        <Border Grid.Column="5" Grid.Row="0" Background="#1D4ED8" Margin="1" CornerRadius="2" Opacity="0.8"/>
                        <Border Grid.Column="4" Grid.Row="0" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="3" Grid.Row="0" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="2" Grid.Row="0" Background="#1A3A10" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="1" Grid.Row="0" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="0" Grid.Row="0" Background="#2D5A27" Margin="1" CornerRadius="2"/>

                        <Border Grid.Column="5" Grid.Row="1" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="4" Grid.Row="1" Background="#5C4A35" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="3" Grid.Row="1" Background="#5C4A35" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="2" Grid.Row="1" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="1" Grid.Row="1" Background="#0E3A5C" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="0" Grid.Row="1" Background="#0E3A5C" Margin="1" CornerRadius="2"/>

                        <Border Grid.Column="5" Grid.Row="2" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="4" Grid.Row="2" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="3" Grid.Row="2" Background="#1A3A10" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="2" Grid.Row="2" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="1" Grid.Row="2" Background="#2D5A27" Margin="1" CornerRadius="2"/>
                        <Border Grid.Column="0" Grid.Row="2" Background="#DC2626" Margin="1" CornerRadius="2" Opacity="0.8"/>
                    </Grid>
                </Border>

                <TextBlock Canvas.Left="55" Canvas.Top="518" Text="Phase 2 — Visual Edition"
                           FontSize="11" Foreground="#334155" FontFamily="Consolas"/>
            </Canvas>
        </Grid>

        <!-- ── Panneau menu droit ── -->
        <Border Grid.Column="1" Background="#111520"
                BorderBrush="#1E293B" BorderThickness="1,0,0,0">
            <StackPanel VerticalAlignment="Center" Margin="40,0">

                <TextBlock Text="MAIN MENU" Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,20"/>

                <Button Content="⚔  New Game"
                        Style="{StaticResource PrimaryBtn}"
                        Background="#1D4ED8"
                        Click="BtnNouvellePartie_Click" Margin="0,4"/>

                <Button Content="📂  Load Game"
                        Style="{StaticResource PrimaryBtn}"
                        Background="#1A2035"
                        BorderBrush="#1E293B" BorderThickness="1"
                        Click="BtnChargerPartie_Click" Margin="0,4"/>

                <Button Content="🗺  World Editor"
                        Style="{StaticResource PrimaryBtn}"
                        Background="#064E3B"
                        Click="BtnEditeurMonde_Click" Margin="0,4"/>

                <Button Content="📜  Game History"
                        Style="{StaticResource PrimaryBtn}"
                        Background="#1C1917"
                        BorderBrush="#78350F" BorderThickness="1"
                        Click="BtnHistorique_Click" Margin="0,4"/>

                <Rectangle Height="1" Fill="#1E293B" Margin="0,20"/>

                <Button Content="✕  Quit"
                        Style="{StaticResource PrimaryBtn}"
                        Background="#1A0A0A"
                        BorderBrush="#3F1515" BorderThickness="1"
                        Click="BtnQuitter_Click" Margin="0,4"/>

                <TextBlock Text="© 2026 HugoLand Team" FontSize="10"
                           Foreground="#1E293B" FontFamily="Consolas"
                           HorizontalAlignment="Center" Margin="0,30,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
