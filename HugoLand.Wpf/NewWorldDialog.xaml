<Window x:Class="HugoLandWpf.NewWorldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New World" Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#111520">
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Create" Width="90" Margin="0,0,10,0"
                    Background="#1D4ED8" Foreground="White"
                    BorderThickness="0" Padding="0,10"
                    FontSize="12" FontFamily="Consolas" Cursor="Hand"
                    Click="BtnCreer_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancel" Width="80"
                    Background="#1A0A0A" Foreground="#EF4444"
                    BorderBrush="#3F1515" BorderThickness="1"
                    Padding="0,10" FontSize="12" FontFamily="Consolas"
                    Cursor="Hand" Click="BtnAnnuler_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3F1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Create a new world"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       FontFamily="Segoe UI" Margin="0,0,0,20"/>

            <TextBlock Text="Name (max 50 characters):"
                       Foreground="#94A3B8" FontSize="12" FontFamily="Consolas"/>
            <TextBox x:Name="TxtNom" Background="#1A2035" Foreground="White"
                     BorderBrush="#3B82F6" BorderThickness="1"
                     Margin="0,6,0,14" Padding="8,6"
                     FontSize="12" MaxLength="50" CaretBrush="White"/>

            <TextBlock Text="Description (optional):"
                       Foreground="#94A3B8" FontSize="12" FontFamily="Consolas"/>
            <TextBox x:Name="TxtDescription" Background="#1A2035" Foreground="White"
                     BorderBrush="#1E293B" BorderThickness="1"
                     Margin="0,6,0,14" Padding="8,6"
                     Height="70" MaxLength="500"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     CaretBrush="White"/>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Width (10-50):"
                               Foreground="#94A3B8" FontSize="12" FontFamily="Consolas"/>
                    <TextBox x:Name="TxtLargeur" Text="15"
                             Background="#1A2035" Foreground="White"
                             BorderBrush="#1E293B" BorderThickness="1"
                             Margin="0,6,0,0" Padding="8,6"
                             FontSize="12" CaretBrush="White"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Height (10-50):"
                               Foreground="#94A3B8" FontSize="12" FontFamily="Consolas"/>
                    <TextBox x:Name="TxtHauteur" Text="10"
                             Background="#1A2035" Foreground="White"
                             BorderBrush="#1E293B" BorderThickness="1"
                             Margin="0,6,0,0" Padding="8,6"
                             FontSize="12" CaretBrush="White"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
