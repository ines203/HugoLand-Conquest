<Window x:Class="HugoLandWpf.WorldEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Éditeur de monde — HugoLand" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Closing="Window_Closing"
        Icon="Assets/HugoLand_Conquest_Logo.ico">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panneau gauche : outils -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">

            <!-- Liste des mondes -->
            <TextBlock Text="Mes mondes" Foreground="White" FontSize="14"
                       FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox x:Name="LstMondes" Height="180" Background="#2A2A2A"
                     Foreground="White" BorderBrush="#555"
                     SelectionChanged="LstMondes_SelectionChanged"/>

            <Button Content="+ Nouveau monde" Margin="0,5,0,0"
                    Style="{StaticResource PrimaryBtn}"
                    Background="#1565C0" Click="BtnNouveauMonde_Click"/>

            <Separator Margin="0,15,0,15" Background="#555"/>

            <!-- Propriétés du monde sélectionné -->
            <TextBlock Text="Propriétés" Foreground="White" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Text="Nom :" Foreground="#90A4AE" FontSize="11"/>
            <TextBox x:Name="TxtNom" Background="#2A2A2A" Foreground="White"
                     BorderBrush="#555" Margin="0,2,0,8" Padding="4"/>

            <TextBlock Text="Description :" Foreground="#90A4AE" FontSize="11"/>
            <TextBox x:Name="TxtDescription" Background="#2A2A2A" Foreground="White"
                     BorderBrush="#555" Margin="0,2,0,8" Padding="4" Height="50"
                     TextWrapping="Wrap" AcceptsReturn="True"/>

            <Separator Margin="0,10,0,10" Background="#555"/>

            <!-- Pinceau terrain -->
            <TextBlock Text="Pinceau terrain" Foreground="White" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Left click = paint terrain" Foreground="#64748B" FontSize="10"
                       FontFamily="Consolas" Margin="0,0,0,2"/>
            <TextBlock Text="Right click = set start position" Foreground="#64748B" FontSize="10"
                       FontFamily="Consolas" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton x:Name="RbPlaine" Content="Plaine" Foreground="White"
                             IsChecked="True" Margin="0,0,10,0" Checked="Rb_Checked"/>
                <RadioButton x:Name="RbForet" Content="Forêt" Foreground="White"
                             Margin="0,0,10,0" Checked="Rb_Checked"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="RbMontagne" Content="Montagne" Foreground="White"
                             Margin="0,0,10,0" Checked="Rb_Checked"/>
                <RadioButton x:Name="RbMer" Content="Mer" Foreground="White"
                             Checked="Rb_Checked"/>
            </StackPanel>

            <!-- Positions de départ -->
            <TextBlock Text="Positions de départ" Foreground="White" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton x:Name="RbDepart1" Content="Joueur 1" Foreground="#2196F3"
                             Margin="0,0,10,0" Checked="Rb_Checked"/>
                <RadioButton x:Name="RbDepart2" Content="Joueur 2" Foreground="#F44336"
                             Checked="Rb_Checked"/>
            </StackPanel>

            <TextBlock x:Name="TxtDepart1" Text="J1 : non défini"
                       Foreground="#2196F3" FontSize="11" Margin="0,4,0,2"/>
            <TextBlock x:Name="TxtDepart2" Text="J2 : non défini"
                       Foreground="#F44336" FontSize="11" Margin="0,2,0,10"/>

            <Separator Margin="0,5,0,10" Background="#555"/>

            <!-- Distribution terrain -->
            <TextBlock x:Name="TxtDistribution" Text="Distribution : —"
                       Foreground="#90A4AE" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Actions -->
            <Button Content="✔ Valider le monde" Style="{StaticResource PrimaryBtn}"
                    Background="#2E7D32" Click="BtnValider_Click" Margin="0,0,0,5"/>
            <Button Content="💾 Sauvegarder" Style="{StaticResource PrimaryBtn}"
                    Click="BtnSauvegarder_Click" Margin="0,0,0,5"/>
            <Button Content="← Retour au menu" Style="{StaticResource PrimaryBtn}"
                    Background="#B71C1C" Click="BtnRetour_Click"/>
        </StackPanel>

        <!-- Zone de la grille -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitreMonde" Grid.Row="0"
                       Text="Sélectionnez ou créez un monde"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="CanvasGrille" Background="#2A2A2A"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
